# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- ASR providers ---
GROQ_API_KEY='your-groq-key'
# Only needed for Hindi/Hinglish videos (language tag routes to Sarvam). Groq-only runs can leave this blank.
SARVAM_API_KEY='your-sarvam-key'

# --- Async ingest (Stage 2) ---
# Neon Postgres connection string for the jobs table. Keep Neon's sslmode/channel_binding
# params intact — psycopg2-binary handles channel_binding=require as-is.
DATABASE_URL='postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# --- Qdrant Cloud (Stage 2 — server mode, replaces embedded file store) ---
# Free-tier cluster URL + API key from cloud.qdrant.io.
QDRANT_URL='https://xxxx-xxxx.region.aws.cloud.qdrant.io:6333'
QDRANT_API_KEY='your-qdrant-cloud-key'
